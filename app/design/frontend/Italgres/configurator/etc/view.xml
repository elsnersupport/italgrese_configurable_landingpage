<?xml version="1.0"?>
<!--
  Merged over Hyvä's view.xml (only what differs is declared here).
  product_base_image is what og:image uses; the configurator replaces the product gallery, so on this
  theme it only feeds share previews, which want at least 1200 px. frame=false keeps the render's aspect.
-->
<view xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:Config/etc/view.xsd">
    <media>
        <images module="Magento_Catalog">
            <image id="product_base_image" type="image">
                <width>1200</width>
                <height>1000</height>
                <frame>false</frame>
            </image>
        </images>
    </media>
</view>
