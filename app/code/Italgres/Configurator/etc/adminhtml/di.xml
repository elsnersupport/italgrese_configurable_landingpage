<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Adds the 3D columns to Customizable Options in the product form -->
    <virtualType name="Magento\Catalog\Ui\DataProvider\Product\Form\Modifier\Pool">
        <arguments>
            <argument name="modifiers" xsi:type="array">
                <item name="italgres-configurator-options" xsi:type="array">
                    <item name="class" xsi:type="string">Italgres\Configurator\Ui\DataProvider\Product\Form\Modifier\ConfiguratorOptions</item>
                    <item name="sortOrder" xsi:type="number">75</item>
                </item>
            </argument>
        </arguments>
    </virtualType>
</config>
