<?xml version="1.0"?>
<!--
  three.js GLTFLoader decodes the textures embedded in a .glb through blob: URLs
  (fetched by ImageBitmapLoader, or set as an <img> src where createImageBitmap is unavailable).
-->
<csp_whitelist xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Csp:etc/csp_whitelist.xsd">
    <policies>
        <policy id="img-src">
            <values>
                <value id="italgres-cfg-blob" type="host">blob:</value>
            </values>
        </policy>
        <policy id="connect-src">
            <values>
                <value id="italgres-cfg-blob" type="host">blob:</value>
            </values>
        </policy>
    </policies>
</csp_whitelist>
