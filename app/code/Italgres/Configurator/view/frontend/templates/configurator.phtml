<script>
    function igConfigurator() {
        const config = JSON.parse(document.getElementById('ig-cfg-data').textContent);
        const money = new Intl.NumberFormat(config.price.locale || 'en-US', {
            style: 'currency', currency: config.price.currency || 'USD', maximumFractionDigits: 0
        });
        const globToRe = (p) => new RegExp('^' + p.trim().replace(/[.+?^${}()|[\]\\]/g, '\\$&').replace(/\*/g, '.*') + '$', 'i');
        const patterns = (t) => String(t || '').split(/[,\n]+/).map((s) => s.trim()).filter(Boolean);
        const skuToOption = {};
        const valueBySku = {};
        config.options.forEach((o) => o.values.forEach((v) => {
            if (v.sku) {
                skuToOption[v.sku] = o.id;
                valueBySku[v.sku] = {option: o, value: v};
            }
        }));
        // Kept outside Alpine's reactive state: a proxied Three.js scene breaks identity checks and is slow.
        let viewer = null;
        let applySeq = 0;
        let thumbsFor = null;
        const backgrounds = {
            studio: ['#f6f2ec', '#e9e2d8'],
            gallery: ['#eceae6', '#d8d4cd'],
            night: ['#2b2926', '#191816'],
            white: ['#fbfbfa', '#efefed'],
        };
        const families = {
            fabric: '<?= $escaper->escapeJs(__('Fabrics')) ?>',
            leather: '<?= $escaper->escapeJs(__('Leathers')) ?>',
            wood: '<?= $escaper->escapeJs(__('Woods')) ?>',
            metal: '<?= $escaper->escapeJs(__('Metals')) ?>',
            porcelain: '<?= $escaper->escapeJs(__('Porcelain')) ?>',
        };
        const isMirror = (value) => /mirror/i.test(value.param || '');
        const isEmptyElement = (value) => value.action === 'compose' && !value.target;

        return {
            config,
            selected: {},
            openStep: null,
            loading: true,
            progress: 0,
            viewerError: false,
            background: backgrounds[config.scene] ? config.scene : 'studio',
            showDims: false,
            autoRotate: config.view !== 'front' && !window.matchMedia('(prefers-reduced-motion: reduce)').matches,
            activeView: config.view || 'angle',
            views: [
                {id: 'front', label: '<?= $escaper->escapeJs(__('Front')) ?>'},
                {id: 'angle', label: '¾'},
                {id: 'side', label: '<?= $escaper->escapeJs(__('Side')) ?>'},
                {id: 'top', label: '<?= $escaper->escapeJs(__('Top')) ?>'},
                {id: 'detail', label: '<?= $escaper->escapeJs(__('Detail')) ?>'},
            ],
            hoverStep: null,
            thumbs: {},
            dims: null,
            qty: 1,
            adding: false,
            drawer: false,
            cart: {items: [], count: 0, subtotal: ''},
            toast: null,
            displayTotal: 0,
            quoteOpen: false,
            quoteSending: false,
            quoteDone: null,
            quoteError: '',
            quoteThumb: '',
            quote: {
                name: '', email: '', phone: '', city: '', country: '', company: '', message: '',
                customer_type: 'homeowner', contact_preference: 'email', consent: false, website: '',
            },

            init() {
                this.applySelection(this.sharedSelection());
                this.openStep = this.visibleOptions()[0] ? this.visibleOptions()[0].id : null;
                this.displayTotal = this.total();
                this.bootViewer();
            },

            /* ---------- selection and rules ---------- */

            selectedValue(option) {
                const id = this.selected[option.id];
                return id ? option.values.find((v) => v.id === id) || null : null;
            },

            isAvailable(value) {
                const groups = {};
                (value.requires || []).forEach((sku) => {
                    const optionId = skuToOption[sku];
                    if (optionId) (groups[optionId] = groups[optionId] || []).push(sku);
                });
                return Object.entries(groups).every(([optionId, skus]) => {
                    const option = config.options.find((o) => o.id === Number(optionId));
                    const current = option ? this.selectedValue(option) : null;
                    return current && skus.includes(current.sku);
                });
            },

            availableValues(option) {
                return option.values.filter((v) => this.isAvailable(v));
            },

            visibleOptions() {
                return config.options.filter((o) => this.availableValues(o).length > 0);
            },

            nextOption(option) {
                const list = this.steps();
                const i = list.findIndex((o) => o.id === option.id);
                return i >= 0 && i < list.length - 1 ? list[i + 1] : null;
            },

            /* ---------- steps and element rows ---------- */

            /** Panel steps: consecutive "sequence" options (element slots) fold into the first one */
            steps() {
                return this.visibleOptions().filter((o, i, list) => !(o.display === 'sequence' && i > 0 && list[i - 1].display === 'sequence'));
            },

            /** The panel step an option is shown in */
            stepOf(optionId) {
                const list = this.visibleOptions();
                let i = list.findIndex((o) => o.id === optionId);
                if (i < 0) return null;
                while (list[i].display === 'sequence' && i > 0 && list[i - 1].display === 'sequence') i--;
                return list[i];
            },

            stepTitle(option) {
                return option.display === 'sequence' ? option.title.replace(/\s*\d+$/, '') : option.title;
            },

            stepValue(option) {
                if (option.display === 'sequence') {
                    const names = this.filledSlots(option).map((slot) => this.selectedValue(slot).title);
                    return names.length ? names.join(' + ') : '<?= $escaper->escapeJs(__('None')) ?>';
                }
                const value = this.selectedValue(option);
                return value ? value.title : '';
            },

            /** Every slot option of the run a sequence step starts, visible or not */
            allSlotsOf(step) {
                const i = config.options.findIndex((o) => o.id === step.id);
                const slots = [];
                for (let k = i; k >= 0 && k < config.options.length && config.options[k].display === 'sequence'; k++) {
                    slots.push(config.options[k]);
                }
                return slots;
            },

            filledSlots(step) {
                const filled = [];
                for (const slot of this.allSlotsOf(step)) {
                    const value = this.selectedValue(slot);
                    if (!value || isEmptyElement(value) || !this.availableValues(slot).length) break;
                    filled.push(slot);
                }
                return filled;
            },

            nextSlot(step) {
                return this.allSlotsOf(step).find((slot) => {
                    const value = this.selectedValue(slot);
                    return this.availableValues(slot).length && (!value || isEmptyElement(value));
                }) || null;
            },

            /** Elements that can be added: the next free slot's choices (with that slot's price) */
            addableValues(step) {
                const slots = this.allSlotsOf(step);
                const slot = this.nextSlot(step) || slots[slots.length - 1];
                return slot ? slot.values.filter((v) => v.action === 'compose' && v.target) : [];
            },

            addElement(step, value) {
                const slot = this.nextSlot(step);
                const match = slot && this.availableValues(slot).find((v) => v.target === value.target && v.param === value.param);
                if (!match) return;
                this.select(slot, match);
                this.openStep = step.id;
                this.notify(`${match.title} · ${this.money(this.total())}`);
            },

            /** Removes element n and moves the ones after it up a slot */
            removeElement(step, n) {
                const slots = this.allSlotsOf(step);
                const chosen = this.filledSlots(step).map((slot) => this.selectedValue(slot));
                chosen.splice(n, 1);
                slots.forEach((slot, k) => {
                    const want = chosen[k];
                    const value = slot.values.find((v) => (want ? v.target === want.target && v.param === want.param : isEmptyElement(v)));
                    if (value) this.selected[slot.id] = value.id;
                });
                this.normalize();
                this.refresh();
            },

            sequenceStep() {
                return this.steps().find((o) => o.display === 'sequence') || null;
            },

            /** Swatches grouped by library material (collection), e.g. Fabrics › Mida */
            swatchGroups(option) {
                const groups = [];
                this.availableValues(option).forEach((value) => {
                    const material = value.materialId ? config.materials[value.materialId] : null;
                    const key = material ? material.id : 0;
                    let group = groups.find((g) => g.key === key);
                    if (!group) {
                        group = {key, name: material ? material.name : '', family: material ? material.family : '', values: []};
                        groups.push(group);
                    }
                    group.values.push(value);
                });
                return groups;
            },

            familyLabel(family) {
                return families[family] || family;
            },

            /** Keep every step valid; returns the steps whose value had to change */
            normalize() {
                const changed = [];
                for (let pass = 0; pass < 2; pass++) {
                    config.options.forEach((option) => {
                        const available = this.availableValues(option);
                        const current = this.selected[option.id];
                        if (!available.length) {
                            delete this.selected[option.id];
                        } else if (!available.some((v) => v.id === current)) {
                            // Default to the included (no surcharge) choice, so the opening price is the base price
                            const fallback = available.find((v) => !this.valuePrice(v)) || available[0];
                            this.selected[option.id] = fallback.id;
                            if (current) changed.push({option, value: fallback});
                        }
                    });
                }
                return changed;
            },

            applySelection(preset) {
                this.selected = {};
                config.options.forEach((o) => {
                    if (preset[o.id]) this.selected[o.id] = preset[o.id];
                });
                this.normalize();
            },

            select(option, value) {
                if (this.selected[option.id] === value.id) return;
                this.selected[option.id] = value.id;
                const changed = this.normalize().filter((c) => c.option.id !== option.id);
                if (changed.length) {
                    const c = changed[0];
                    this.notify(`${c.option.title}: ${c.value.title} — <?= $escaper->escapeJs(__('matched to your new choice')) ?>`);
                }
                this.refresh();
            },

            reset() {
                this.applySelection({});
                this.qty = 1;
                this.openStep = this.visibleOptions()[0] ? this.visibleOptions()[0].id : null;
                history.replaceState(null, '', location.pathname);
                this.refresh();
            },

            toggleStep(id) {
                this.openStep = this.openStep === id ? null : id;
            },

            scrollToStep(id) {
                this.$nextTick(() => {
                    const el = document.getElementById('ig-step-' + id);
                    if (el) el.scrollIntoView({behavior: 'smooth', block: 'nearest'});
                });
            },

            previewHint() {},

            /* ---------- pricing ---------- */

            valuePrice(value) {
                return value.priceType === 'percent' ? config.price.base * value.price / 100 : value.price;
            },

            total() {
                return config.options.reduce((sum, o) => {
                    const v = this.selectedValue(o);
                    return v ? sum + this.valuePrice(v) : sum;
                }, config.price.base);
            },

            money(amount) {
                return money.format(Math.round(amount));
            },

            priceLabel(value) {
                const p = this.valuePrice(value);
                if (!p) return '<?= $escaper->escapeJs(__('Included')) ?>';
                return (p > 0 ? '+' : '−') + this.money(Math.abs(p));
            },

            animatePrice() {
                const from = this.displayTotal;
                const to = this.total();
                const start = performance.now();
                const step = (now) => {
                    const t = Math.min(1, (now - start) / 450);
                    this.displayTotal = from + (to - from) * (1 - Math.pow(1 - t, 3));
                    if (t < 1) requestAnimationFrame(step);
                };
                requestAnimationFrame(step);
            },

            summary() {
                return this.visibleOptions().map((o) => {
                    const v = this.selectedValue(o);
                    // An empty element slot only matters when it changes the price
                    if (!v || (isEmptyElement(v) && !this.valuePrice(v))) return null;
                    return {option: o.title, value: v.title, price: this.valuePrice(v)};
                }).filter(Boolean);
            },

            code() {
                const parts = this.visibleOptions().map((o) => {
                    const v = this.selectedValue(o);
                    return v && v.sku ? v.sku : null;
                }).filter(Boolean);
                return [config.product.sku].concat(parts).join('-');
            },

            thumbKey(value) {
                return `${value.target}|${isMirror(value) ? 1 : 0}`;
            },

            /** Live 3D preview of an element (rendered by the viewer in the current cover) */
            elementThumb(value) {
                return value && value.action === 'compose' && value.target ? this.thumbs[this.thumbKey(value)] || null : null;
            },

            refreshThumbs(look) {
                const key = JSON.stringify(look.parts);
                if (!viewer || key === thumbsFor) return;
                const list = [];
                const seen = new Set();
                config.options.forEach((o) => o.values.forEach((v) => {
                    if (v.action !== 'compose' || !v.target || seen.has(this.thumbKey(v))) return;
                    seen.add(this.thumbKey(v));
                    list.push({target: v.target, mirror: isMirror(v)});
                }));
                if (!list.length) return;
                thumbsFor = key;
                this.thumbs = viewer.renderThumbnails(list);
            },

            swatchStyle(value) {
                const thumb = this.elementThumb(value);
                if (thumb) return `background-image:url('${thumb}')`;
                if (!value || !value.swatch) return '';
                if (value.swatch.image) {
                    return `background:${value.swatch.value} url('${value.swatch.image}') center/cover;background-blend-mode:multiply`;
                }
                return value.swatch.type === 'image'
                    ? `background-image:url('${value.swatch.value}')`
                    : `background:${value.swatch.value}`;
            },

            libraryMaterials() {
                const ids = new Set();
                config.options.forEach((o) => o.values.forEach((v) => v.materialId && ids.add(v.materialId)));
                return [...ids].map((id) => config.materials[id]).filter(Boolean);
            },

            /* ---------- 3D ---------- */

            look() {
                const look = {model: null, widthCm: null, parts: [], visibility: []};
                this.visibleOptions().forEach((o) => {
                    const v = this.selectedValue(o);
                    if (!v) return;
                    switch (v.action) {
                        case 'material':
                            look.parts.push({target: v.target, material: v.materialId, color: v.color || null});
                            break;
                        case 'color':
                            look.parts.push({target: v.target, color: v.color});
                            break;
                        case 'props':
                            look.parts.push({target: v.target, props: this.parseProps(v.param)});
                            break;
                        case 'stretch':
                            look.widthCm = parseFloat(v.param) || null;
                            break;
                        case 'model':
                            look.model = v.param || null;
                            break;
                        case 'visibility':
                            look.visibility.push({target: v.target});
                            break;
                        case 'repeat':
                            look.repeat = {target: v.target, count: parseInt(v.param, 10) || 1};
                            break;
                        case 'compose':
                            look.compose = look.compose || [];
                            if (v.target) look.compose.push({target: v.target, mirror: isMirror(v), step: this.stepOf(o.id)?.id ?? o.id});
                            break;
                    }
                });
                return look;
            },

            parseProps(param) {
                const props = {};
                String(param || '').split(/[,;]+/).forEach((pair) => {
                    const [k, val] = pair.split(':').map((s) => s && s.trim());
                    if (k && val !== undefined && !isNaN(parseFloat(val))) props[k] = parseFloat(val);
                });
                return props;
            },

            async bootViewer() {
                if (viewer) return;
                try {
                    const mod = await import(config.viewerUrl);
                    viewer = new mod.ConfiguratorViewer(this.$refs.canvas, {
                        view: config.view || 'angle',
                        dimLayer: this.$refs.dims,
                        hotspotLayer: this.$refs.hotspots,
                        onProgress: (p) => { this.progress = Math.round(p * 100); },
                        onPick: (names) => this.focusPart(names),
                        onHover: (names) => { this.hoverStep = names ? (this.stepForPart(names) || {}).title || null : null; },
                        onDimensions: (d) => { this.dims = d; },
                        onAutoRotate: (on) => { this.autoRotate = on; },
                    });
                    window.igConfiguratorViewer = viewer;
                    viewer.setLibrary(config.materials, config.models, config.model);
                    const look = this.look();
                    await viewer.apply(look, {animate: false});
                    viewer.setAutoRotate(this.autoRotate);
                    viewer.setHotspotsVisible(!!this.repeatOption() || !!this.sequenceStep());
                    this.refreshThumbs(look);
                    this.loading = false;
                } catch (e) {
                    console.error('Configurator viewer failed', e);
                    viewerError = true;
                    this.loading = false;
                }
            },

            refresh() {
                this.animatePrice();
                if (!viewer) return;
                const look = this.look();
                const seq = ++applySeq;
                // Element previews follow the cover once the newest look has its materials
                viewer.apply(look).then(() => seq === applySeq && this.refreshThumbs(look));
            },

            stepForPart(names, after = null) {
                const hits = (actions) => this.visibleOptions().filter((o) => this.availableValues(o).some((v) =>
                    actions.includes(v.action) &&
                    patterns(v.target).filter((p) => !p.startsWith('!')).some((p) => names.some((n) => globToRe(p).test(n)))
                ));
                // A composed element knows the step that chose it ("step:<id>"), so that step comes first
                const own = names.filter((n) => String(n).startsWith('step:')).map((n) => this.stepOf(Number(String(n).slice(5))));
                const matches = [...own, ...hits(['material', 'color', 'props']), ...hits(['visibility', 'repeat'])]
                    .filter(Boolean)
                    .map((o) => this.stepOf(o.id))
                    .filter((o, i, all) => o && all.findIndex((x) => x && x.id === o.id) === i);
                if (!matches.length) return null;
                const i = after ? matches.findIndex((o) => o.id === after) : -1;
                const match = matches[(i + 1) % matches.length];
                return match ? {...match, title: this.stepTitle(match)} : null;
            },

            focusPart(names) {
                const option = this.stepForPart(names, this.openStep);
                if (!option) return;
                this.openStep = option.id;
                this.scrollToStep(option.id);
            },

            /* ---------- steppers and repeated modules ---------- */

            canStep(option, dir) {
                const values = this.availableValues(option);
                const i = values.findIndex((v) => v.id === this.selected[option.id]);
                return i + dir >= 0 && i + dir < values.length;
            },

            stepOption(option, dir) {
                const values = this.availableValues(option);
                const i = values.findIndex((v) => v.id === this.selected[option.id]);
                const next = values[i + dir];
                if (next) this.select(option, next);
                return next;
            },

            repeatOption() {
                return this.visibleOptions().find((o) => o.values.some((v) => v.action === 'repeat')) || null;
            },

            canRepeat(dir) {
                const option = this.repeatOption();
                return !!option && this.canStep(option, dir);
            },

            /** The + buttons on the piece: one more repeated seat, or the first element into the next free slot */
            canAddModule() {
                if (this.repeatOption()) return this.canRepeat(1);
                const step = this.sequenceStep();
                return !!step && !!this.nextSlot(step);
            },

            addModule() {
                if (this.repeatOption()) return this.stepRepeat(1);
                const step = this.sequenceStep();
                const value = step && this.addableValues(step)[0];
                if (value) this.addElement(step, value);
            },

            stepRepeat(dir) {
                const option = this.repeatOption();
                if (!option) return;
                const next = this.stepOption(option, dir);
                if (next) {
                    this.openStep = option.id;
                    this.notify(`${next.title} · ${this.money(this.total())}`);
                }
            },

            setView(id) {
                this.activeView = id;
                if (viewer) viewer.setView(id);
            },

            toggleDims() {
                this.showDims = !this.showDims;
                if (viewer) viewer.setDimensionsVisible(this.showDims);
            },

            toggleRotate() {
                this.autoRotate = !this.autoRotate;
                if (viewer) viewer.setAutoRotate(this.autoRotate);
            },

            cycleBackground() {
                const keys = Object.keys(backgrounds);
                this.background = keys[(keys.indexOf(this.background) + 1) % keys.length];
            },

            toggleFullscreen() {
                const stage = this.$refs.stage;
                if (document.fullscreenElement) document.exitFullscreen();
                else if (stage.requestFullscreen) stage.requestFullscreen();
            },

            downloadImage() {
                if (!viewer) return;
                viewer.snapshot(backgrounds[this.background]).toBlob((blob) => {
                    const a = document.createElement('a');
                    a.href = URL.createObjectURL(blob);
                    a.download = this.code() + '.png';
                    a.click();
                    setTimeout(() => URL.revokeObjectURL(a.href), 2000);
                }, 'image/png');
            },

            /* ---------- sharing ---------- */

            sharedSelection() {
                const preset = {};
                const param = new URLSearchParams(location.search).get('cfg');
                (param ? param.split('.') : []).forEach((sku) => {
                    const hit = valueBySku[decodeURIComponent(sku)];
                    if (hit) preset[hit.option.id] = hit.value.id;
                });
                return preset;
            },

            shareUrl() {
                const skus = this.visibleOptions().map((o) => this.selectedValue(o)).filter((v) => v && v.sku).map((v) => encodeURIComponent(v.sku));
                return location.origin + location.pathname + '?cfg=' + skus.join('.');
            },

            async copyLink() {
                const url = this.shareUrl();
                history.replaceState(null, '', url);
                try {
                    await navigator.clipboard.writeText(url);
                    this.notify('<?= $escaper->escapeJs(__('Link copied. Anyone with it sees this exact configuration.')) ?>');
                } catch (e) {
                    this.notify(url);
                }
            },

            /* ---------- cart ---------- */

            async addToCart() {
                if (this.adding) return;
                this.adding = true;
                const body = new URLSearchParams();
                body.append('form_key', hyva.getFormKey());
                body.append('product', config.product.id);
                body.append('qty', this.qty);
                Object.entries(this.selected).forEach(([optionId, valueId]) => body.append(`options[${optionId}]`, valueId));
                try {
                    const response = await fetch(config.urls.add, {
                        method: 'POST',
                        body,
                        headers: {'X-Requested-With': 'XMLHttpRequest'},
                    });
                    const result = await response.json();
                    if (!result.success) throw new Error(result.message);
                    this.storeThumb(result.itemId);
                    this.drawer = true;
                    await this.refreshCart();
                    this.notify(result.message);
                } catch (e) {
                    this.notify(e.message || '<?= $escaper->escapeJs(__('Something went wrong. Please try again.')) ?>');
                } finally {
                    this.adding = false;
                }
            },

            async removeItem(itemId) {
                const body = new URLSearchParams();
                body.append('form_key', hyva.getFormKey());
                body.append('item_id', itemId);
                this.cart.items = this.cart.items.filter((i) => i.item_id !== itemId);
                await fetch(config.urls.remove, {method: 'POST', body, headers: {'X-Requested-With': 'XMLHttpRequest'}});
                await this.refreshCart();
            },

            /** Load the cart section straight away, then let Hyvä refresh its cache (header count etc.) */
            async refreshCart() {
                try {
                    const response = await fetch(BASE_URL + 'customer/section/load/?sections=cart&force_new_section_timestamp=true', {
                        headers: {'X-Requested-With': 'XMLHttpRequest'},
                    });
                    this.onSections(await response.json());
                } catch (e) { /* the drawer keeps its last state */ }
                window.dispatchEvent(new CustomEvent('reload-customer-section-data'));
            },

            onSections(data) {
                const cart = (data && data.cart) || {};
                this.cart = {
                    items: cart.items || [],
                    count: cart.summary_count || 0,
                    subtotal: cart.subtotal || '',
                };
            },

            storeThumb(itemId) {
                if (!viewer || !itemId) return;
                try {
                    const url = viewer.snapshot(backgrounds[this.background], 360, true).toDataURL('image/jpeg', 0.82);
                    sessionStorage.setItem('ig-thumb-' + itemId, url);
                } catch (e) { /* storage full or unavailable: fall back to the product image */ }
            },

            thumbFor(item) {
                try {
                    const stored = sessionStorage.getItem('ig-thumb-' + item.item_id);
                    if (stored) return stored;
                } catch (e) { /* ignore */ }
                return item.product_image ? item.product_image.src : '';
            },

            /* ---------- quote request ---------- */

            dimsLabel() {
                return this.dims ? `${this.dims.width} × ${this.dims.depth} × ${this.dims.height} cm` : '';
            },

            openQuote() {
                this.quoteError = '';
                if (this.quoteDone) this.quoteDone = null;
                try {
                    this.quoteThumb = viewer ? viewer.snapshot(backgrounds[this.background], 1200, true).toDataURL('image/jpeg', 0.84) : '';
                } catch (e) {
                    this.quoteThumb = '';
                }
                this.quoteOpen = true;
            },

            async submitQuote() {
                if (this.quoteSending) return;
                const q = this.quote;
                if (!q.name.trim()) return this.quoteError = '<?= $escaper->escapeJs(__('Please enter your name.')) ?>';
                if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(q.email.trim())) return this.quoteError = '<?= $escaper->escapeJs(__('Please enter a valid email address.')) ?>';
                if (q.contact_preference !== 'email' && !q.phone.trim()) return this.quoteError = '<?= $escaper->escapeJs(__('Please add a phone number so we can call you back.')) ?>';
                if (!q.consent) return this.quoteError = '<?= $escaper->escapeJs(__('Please agree to be contacted about this request.')) ?>';
                this.quoteError = '';
                this.quoteSending = true;
                const body = new URLSearchParams();
                body.append('form_key', hyva.getFormKey());
                body.append('product', config.product.id);
                body.append('qty', this.qty);
                Object.entries(this.selected).forEach(([optionId, valueId]) => body.append(`options[${optionId}]`, valueId));
                Object.entries(q).forEach(([key, value]) => body.append(key, key === 'consent' ? (value ? '1' : '') : value));
                body.append('dimensions', this.dimsLabel());
                body.append('share_url', this.shareUrl());
                if (this.quoteThumb) body.append('snapshot', this.quoteThumb);
                try {
                    const response = await fetch(config.urls.quote, {
                        method: 'POST',
                        body,
                        headers: {'X-Requested-With': 'XMLHttpRequest'},
                    });
                    const result = await response.json();
                    if (!result.success) throw new Error(result.message);
                    this.quoteDone = result.reference || '—';
                    this.quote.message = '';
                } catch (e) {
                    this.quoteError = e.message || '<?= $escaper->escapeJs(__('We could not send your request. Please try again.')) ?>';
                } finally {
                    this.quoteSending = false;
                }
            },

            notify(text) {
                this.toast = {text};
                clearTimeout(this.toastTimer);
                this.toastTimer = setTimeout(() => { this.toast = null; }, 3600);
            },
        };
    }
</script>
