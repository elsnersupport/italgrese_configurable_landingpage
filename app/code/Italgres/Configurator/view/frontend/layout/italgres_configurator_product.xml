<?xml version="1.0"?>
<!--
  Applied to products with "Enable 3D Configurator Page" = Yes (see Plugin\AddConfiguratorHandle).
  Replaces the standard Hyvä product page body with the configurator.
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&amp;family=Jost:wght@300;400;500;600&amp;display=swap" src_type="url"/>
        <css src="Italgres_Configurator::css/configurator.css"/>
    </head>
    <body>
        <attribute name="class" value="ig-configurator-page"/>
        <referenceContainer name="product.info.main" remove="true"/>
        <referenceBlock name="product.detail.page" remove="true"/>
        <referenceBlock name="page.main.title" remove="true"/>
        <referenceBlock name="breadcrumbs" remove="true"/>
        <referenceBlock name="product_breadcrumbs" remove="true"/>
        <referenceBlock name="recently_viewed_products.default_widget_pdp" remove="true"/>
        <referenceBlock name="recently_viewed_products.register_view" remove="true"/>
        <referenceBlock name="related" remove="true"/>
        <referenceBlock name="upsell" remove="true"/>
        <referenceBlock name="product.info.details" remove="true"/>
        <referenceBlock name="reviews.tab" remove="true"/>

        <referenceContainer name="content">
            <block name="italgres.configurator" template="Italgres_Configurator::configurator.phtml" before="-">
                <arguments>
                    <argument name="view_model" xsi:type="object">Italgres\Configurator\ViewModel\Configurator</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
