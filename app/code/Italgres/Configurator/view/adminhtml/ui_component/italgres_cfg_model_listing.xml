<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">italgres_cfg_model_listing.italgres_cfg_model_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <buttons>
            <button name="add">
                <url path="*/*/new"/>
                <class>primary</class>
                <label translate="true">Add 3D Model</label>
            </button>
        </buttons>
        <spinner>italgres_cfg_model_columns</spinner>
        <deps>
            <dep>italgres_cfg_model_listing.italgres_cfg_model_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="italgres_cfg_model_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">model_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Italgres_Configurator::models</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider" name="italgres_cfg_model_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>model_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="italgres_cfg_model_columns">
        <column name="model_id" sortOrder="10">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <sorting>asc</sorting>
            </settings>
        </column>
        <column name="name" sortOrder="20">
            <settings>
                <filter>text</filter>
                <label translate="true">Name</label>
            </settings>
        </column>
        <column name="code" sortOrder="30">
            <settings>
                <filter>text</filter>
                <label translate="true">Code</label>
            </settings>
        </column>
        <column name="file" sortOrder="40">
            <settings>
                <label translate="true">GLB File</label>
            </settings>
        </column>
        <column name="base_width_cm" sortOrder="50">
            <settings>
                <label translate="true">Width (cm)</label>
            </settings>
        </column>
        <column name="is_active" component="Magento_Ui/js/grid/columns/select" sortOrder="60">
            <settings>
                <options class="Magento\Config\Model\Config\Source\Yesno"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Active</label>
            </settings>
        </column>
        <actionsColumn name="actions" class="Italgres\Configurator\Ui\Component\Listing\Column\Actions" sortOrder="200">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="routePath" xsi:type="string">italgres_cfg/model</item>
                    <item name="idField" xsi:type="string">model_id</item>
                </item>
            </argument>
            <settings>
                <indexField>model_id</indexField>
            </settings>
        </actionsColumn>
    </columns>
</listing>
